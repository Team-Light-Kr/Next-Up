<Window x:Class="NextUps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="NextUps - 멀티플랫폼 게임 업데이트 정보 통합 플랫폼" 
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" 
                      CornerRadius="12" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="#FFFFFF" 
            BorderBrush="#E2E8F0" 
            BorderThickness="1" 
            CornerRadius="12" 
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.15" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Modern Titlebar UI -->
                <RowDefinition Height="42" />
                <!-- Optional Auto Update Banner -->
                <RowDefinition Height="Auto" />
                <!-- Main WebView2 Container -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLEBAR (UI 개편) -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- App Brand & Title -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Drag Region -->
                        <ColumnDefinition Width="*" />
                        <!-- Window Controls -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- Logo badge -->
                        <Border Background="#2563EB" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0">
                            <TextBlock Text="N" Foreground="White" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="NextUps" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                        <TextBlock Text="|" Foreground="#CBD5E1" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="멀티플랫폼 게임 업데이트 통합 플랫폼" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 DESKTOP" FontSize="9" FontWeight="Bold" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>

                    <!-- Center Drag Area -->
                    <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                    <!-- Window Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Reload Button -->
                        <Button Click="Reload_Click" ToolTip="새로고침 (F5)" Width="40" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="↻" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Minimize Button -->
                        <Button Click="Minimize_Click" ToolTip="최소화" Width="44" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="─" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button Click="Maximize_Click" ToolTip="최대화 / 복원" Width="44" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock x:Name="MaximizeButtonText" Text="□" FontSize="13" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Close Button -->
                        <Button Click="Close_Click" ToolTip="닫기" Width="48" Height="42" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EF4444" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AUTO UPDATE NOTIFICATION BANNER -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Background="#2563EB" Visibility="Collapsed" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀 NextUps 새 버전이 출시되었습니다!" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,10,0" />
                        <TextBlock x:Name="UpdateBannerText" Text="최신 기능과 보안 패치를 지금 즉시 적용하세요." Foreground="#DBEAFE" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="InstallUpdate_Click" Background="White" Foreground="#2563EB" FontWeight="Bold" FontSize="11" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                            <Border CornerRadius="4">
                                <TextBlock Text="지금 업데이트 ↗" />
                            </Border>
                        </Button>
                        <Button Click="DismissUpdate_Click" Background="Transparent" Foreground="White" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WEBVIEW2 ENGINE -->
            <Grid Grid.Row="2" Background="#FFFFFF">
                <wv2:WebView2 x:Name="webView" />
                
                <!-- Loading Splash Overlay -->
                <Grid x:Name="LoadingOverlay" Background="#FFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="16" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="N" Foreground="White" FontWeight="Black" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <TextBlock Text="NextUps" FontWeight="Black" FontSize="20" Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="게임을 준비하고 업데이트를 연결하는 중..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
